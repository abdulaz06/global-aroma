---
import Layout from "../layouts/Layout.astro";
---

<Layout
  includePageUrl={false}
  title="Page not found"
  description="Return to Global Aroma or explore the three business divisions."
>
  <section class="wrap missing-page">
    <p class="eyebrow">Page not found</p>
    <h1>
      Back to the <em>entrance.</em>
    </h1>
    <p>
      This address may have changed. Our homepage will take you to the three
      divisions and Atmosphere Studio.
    </p>
    <a class="button" href="/">
      Return home
    </a>
  </section>
</Layout>
<style>
  .missing-page {
    padding-block: clamp(5rem, 12vw, 12rem);
  }
  h1 {
    font-size: clamp(3.6rem, 7vw, 7.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0.8rem 0 1.3rem;
  }
  h1 em {
    color: var(--copper);
  }
  h1 + p {
    max-width: 43ch;
    line-height: 1.6;
    color: var(--muted);
  }
  .button {
    margin-top: 2rem;
  }
</style>
