---
import Layout from "../layouts/Layout.astro";
import { divisions } from "../data/divisions";
import "../styles/interior.css";

const email = "info@globaldwc.com";
---

<Layout
  title="Contact Global DWC LLC"
  description="Contact the Dubai office about fragrance, hospitality supplies, ICT or an environment you are planning."
>
  <article class="interior contact-page">
    <div class="wrap">
      <header class="contact-intro">
        <p class="eyebrow">Contact</p>
        <h1>
          Tell us about <em>your space.</em>
        </h1>
        <p class="intro-copy">
          For fragrance, hospitality supplies or technology, start a
          conversation with our Dubai office. For retail purchases,
          <a class="text-link" href="/divisions/aroma/#shop">shop oils and diffusers</a>.
        </p>
      </header>
      <div class="contact-columns">
        <section class="inquiry-block" aria-labelledby="inquiry-heading">
          <h2 id="inquiry-heading">Project enquiry</h2>
          <p>
            Choose a subject and add a few details. You can review your draft in
            your email app before sending.
          </p>
          <form id="inquiry-form" action={`mailto:${email}`} method="get">
            <label for="inquiry-subject">Subject</label>
            <select id="inquiry-subject" name="subject">
              <option
                value="General enquiry — Global DWC LLC"
                data-slug="general"
              >
                General enquiry
              </option>
              {divisions.map((division) => (
                <option
                  value={`Project enquiry — ${division.name}`}
                  data-slug={division.slug}
                >
                  {division.name}
                </option>
              ))}
            </select>
            <label for="inquiry-message">Your project</label>
            <textarea
              id="inquiry-message"
              name="body"
              rows="5"
              required
              maxlength="1800"
              placeholder="What kind of space are you working on, and what would you like to explore?"
            ></textarea>
            <div class="form-actions">
              <button class="button" type="submit">
                Open email draft
              </button>
              <button
                class="copy-inquiry inside-link"
                type="button"
                id="copy-inquiry"
                hidden
              >
                Copy enquiry
              </button>
            </div>
            <p class="draft-status" aria-live="polite" id="draft-status"></p>
          </form>
        </section>
        <aside class="office-panel" aria-labelledby="office-heading">
          <p class="eyebrow">United Arab Emirates</p>
          <h2 id="office-heading">Dubai office.</h2>
          <address>
            <strong>Global DWC LLC</strong>
            <br />
            Office 531, 5th Floor, Building A3
            <br />
            Dubai World Central
            <br />
            P.O. Box 712930, Dubai, UAE
          </address>
          <div class="office-detail">
            <span>General enquiries</span>
            <a href={`mailto:${email}`}>{email}</a>
          </div>
          <div class="office-detail">
            <span>Telephone</span>
            <a href="tel:+97143517399">+971 4 351 7399</a>
          </div>
          <div class="office-detail">
            <span>WhatsApp</span>
            <a href="https://wa.me/971555827212">+971 55 582 7212</a>
          </div>
        </aside>
      </div>
    </div>
  </article>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#inquiry-form")!;
  const subject =
    document.querySelector<HTMLSelectElement>("#inquiry-subject")!;
  const body = document.querySelector<HTMLTextAreaElement>("#inquiry-message")!;
  const status = document.querySelector<HTMLElement>("#draft-status")!;
  const copyButton =
    document.querySelector<HTMLButtonElement>("#copy-inquiry")!;

  const query = new URLSearchParams(window.location.search);
  const initialSubject = Array.from(subject.options).find(
    (option) => option.dataset.slug === query.get("division"),
  );
  if (initialSubject) subject.value = initialSubject.value;

  const space = query.get("space")?.trim();
  const brief = query.get("brief")?.trim();
  body.value = [space && `Space: ${space}`, brief]
    .filter(Boolean)
    .join("\n\n")
    .slice(0, body.maxLength);

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    window.location.href = `${form.action}?subject=${encodeURIComponent(subject.value)}&body=${encodeURIComponent(body.value)}`;
    status.textContent =
      "Use your email app to send the draft. You can also email the Dubai office directly.";
  });

  if (navigator.clipboard?.writeText) {
    copyButton.hidden = false;
    copyButton.addEventListener("click", async () => {
      if (!form.reportValidity()) return;
      try {
        await navigator.clipboard.writeText(
          `${subject.value}\n\n${body.value}`,
        );
        status.textContent =
          "Enquiry copied. Paste it into an email to info@globaldwc.com.";
      } catch {
        body.focus();
        body.select();
        status.textContent =
          "Your project text is selected. Use your device’s copy command.";
      }
    });
  }
</script>
